# Copy to `.env` and edit. Compose reads `.env` automatically; it is gitignored
# so the real values stay out of the repository.

# Required. The exact authority browsers use to reach this deployment — no
# scheme, no trailing slash. It is passed to dsh as --trusted-host, which is
# what the /api trust fence compares against; anything the browser addresses
# that is missing here gets HTTP 403 on every API call.
DSH_PUBLIC_HOST=dsh.example.com

# Optional. Extra authorities accepted by the fence, comma-separated — e.g. the
# LAN address you use to reach this box without going through the proxy.
# DSH_TRUSTED_HOSTS=192.168.1.10:3080,dsh.lan

# Optional. Image to run. Defaults to the plain image; use the -plus tag for
# python/pip, the codebase-memory-mcp binary and the Android reverse-engineering
# toolchain (jadx, apktool, smali/baksmali, aapt, dexdump, apksigner, zipalign,
# androguard). Neither variant ships a browser. See "The -plus image" in the
# README.
# DSH_IMAGE=ghcr.io/prv-ctech/deepseek-harness-plus:latest

# Optional. Ownership of the state volume and /workspace.
# PUID=1000
# PGID=1000

# Optional. Host interface and port to publish. The default binds all
# interfaces so the proxy's tunnel agent can reach it.
# DSH_BIND=0.0.0.0
# DSH_PORT=3080

# Optional. Host directory the agent works in (its sandbox root).
# DSH_WORKSPACE=./workspace

# Optional. Sandbox mode: read-only, workspace-write, danger-full-access.
# Leave this alone unless the kernel cannot enforce confinement on your host.
# DSH_PERMISSION_MODE=workspace-write
